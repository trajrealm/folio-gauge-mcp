OPENAI_API_KEY=your_openai_api_key_here

# Optional: any OpenAI-compatible provider. Unset = OpenAI with OPENAI_API_KEY and the models below.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_provider_key_here
# LLM_MODEL_AGENTS=gpt-4o-mini
# LLM_MODEL_EVALUATOR=gpt-4o

# Optional: filing embeddings. Provider defaults to the LLM_* one; a new model gets its own index.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=your_provider_key_here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_langsmith_project_name_here

FRED_API_KEY=your_fred_api_key_here

# SEC requires a contact in the User-Agent: "<app name> <email>"
EDGAR_USER_AGENT=folio-gauge your_email@example.com

# Local Qdrant storage directory (no server needed)
QDRANT_PATH=data/qdrant