OPENAI_API_KEY=your_openai_api_key_here

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_langsmith_project_name_here

FRED_API_KEY=your_fred_api_key_here

# SEC requires a contact in the User-Agent: "<app name> <email>"
EDGAR_USER_AGENT=folio-gauge your_email@example.com

# Local Qdrant storage directory (no server needed)
QDRANT_PATH=data/qdrant